node_modules/
dist/
dist-web/
dist-spa/
*.tsbuildinfo
coverage/

# CLI runtime sqlite (created on first run; not source)
*.sqlite
*.sqlite-shm
*.sqlite-wal

.DS_Store
*.log
npm-debug.log*

.env
.env.*

# Local dev helm values — holds a credentials encryption key; not source
ax-values.yaml
# Per-environment helm value overrides (real project/domain/registry values).
# Pattern: a `*.local.yaml` layered on top of a tracked template via `helm -f`.
# See deploy/GKE.md. Never source — keep real values out of the repo.
*.local.yaml

.vscode/
.idea/

.worktrees/
worktrees/

# Local dev-loop scratch dirs — hostPath mount payload for the kind cluster
# (see deploy/MANUAL-ACCEPTANCE.md) and Playwright MCP per-step snapshots.
.dev-mount/
.playwright-mcp/

# Brainstorming session scratch (mockups, state) — kept local
.superpowers/

# channel-web's vite mock backend seeds 6 JSON files (users/agents/teams/
# mcp-servers/sessions/messages) into `.mock-data/`. It's now anchored to the
# package dir via __dirname (see packages/channel-web/vite.config.ts and
# mock/server.ts, TASK-376), but this root-level entry is cheap insurance
# against it ever landing here again, e.g. via a differently invoked runner.
.mock-data/

# Local handoff/prompt scratch — kept out of git
.claude/prompts/

# auto-ship operational run state (regenerated from the "TO DO" board + gh on resume).
# Wildcard so new run-state files (progress helper, owner lock, …) are covered too;
# the committed skill lives under .claude/skills/auto-ship/ and is NOT matched by this.
.claude/auto-ship-*
