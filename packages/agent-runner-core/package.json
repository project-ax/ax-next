{
  "name": "@ax/agent-runner-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./internal/git-workspace.js": {
      "types": "./dist/git-workspace.d.ts",
      "default": "./dist/git-workspace.js"
    },
    "./internal/python-venv.js": {
      "types": "./dist/python-venv.d.ts",
      "default": "./dist/python-venv.js"
    },
    "./internal/inbox-loop.js": {
      "types": "./dist/inbox-loop.d.ts",
      "default": "./dist/inbox-loop.js"
    },
    "./internal/transcript-delta.js": {
      "types": "./dist/transcript-delta.d.ts",
      "default": "./dist/transcript-delta.js"
    }
  },
  "files": ["dist"],
  "scripts": { "build": "tsc --build", "test": "vitest run", "test:watch": "vitest" },
  "dependencies": {
    "@ax/agent-identity-templates": "workspace:*",
