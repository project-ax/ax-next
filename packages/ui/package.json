{
  "name": "@project-ax/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind/preset.d.ts",
      "default": "./dist/tailwind/preset.js"
    },
    "./ui.css": "./ui.css"
  },
  "files": [
    "dist",
    "theme.css",
    "ui.css"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p eval/tsconfig.json",
    "gen": "tsx scripts/gen-theme.ts && tsx scripts/build-css.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "axe-core": "4.14.0",
    "playwright": "1.59.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
