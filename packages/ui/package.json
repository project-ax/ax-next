{
  "name": "@project-ax/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind/preset.d.ts",
      "default": "./dist/tailwind/preset.js"
    },
    "./ui.css": "./ui.css"
  },
  "files": [
    "dist",
    "theme.css",
    "ui.css"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p eval/tsconfig.json",
    "gen": "tsx scripts/gen-theme.ts && tsx scripts/build-css.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "stories:test": "pnpm build-storybook && playwright test",
    "stories:update": "docker run --rm --platform linux/amd64 -e CI=1 -e COREPACK_ENABLE_DOWNLOAD_PROMPT=0 -e npm_config_store_dir=/tmp/pnpm-store -v \"$PWD/../..\":/w -v /w/node_modules -v /w/packages/ui/node_modules -w /w/packages/ui mcr.microsoft.com/playwright:v1.59.1-noble sh -c 'corepack enable && pnpm install --frozen-lockfile --filter @project-ax/ui... && pnpm build-storybook && pnpm exec playwright test --update-snapshots'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.59.1",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0",
    "playwright": "1.59.1",
    "postcss": "8.5.26",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "storybook": "10.6.7",
    "tailwindcss": "3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "6.4.5",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
