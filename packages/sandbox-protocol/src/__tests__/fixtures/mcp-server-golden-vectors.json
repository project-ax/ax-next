{
  "note": "ARCH-11 shared golden vectors for the MCP-server-entry drift guard. Both @ax/sandbox-protocol's McpServerSchema (the host contract) and the runner's hand-rolled validateMcpEntry (@ax/agent-runner-core, sandbox-side defense-in-depth, intentionally NOT importing the schema) are asserted against THIS one file. Each vector declares its expected verdict PER SIDE: `schema` (McpServerSchema.safeParse(.value).success) and `runner` (validateMcpEntry(.value) returns vs throws). `core: true` vectors test the security-critical shape rules that MUST NEVER diverge — both sides assert schema === runner for those. MCP servers are http-only (stdio was removed 2026-10-04): every stdio entry, and every http entry that still carries the removed stdio-only command/args/env fields, is a core reject on both sides. The ONE `core: false` vector encodes the surviving intentional asymmetry: the runner ignores allowedHosts/credentials (it only emits url/headers into .mcp.json), so a value the schema rejects PURELY on a malformed allowedHosts/credentials field is still accepted by the runner. That direction (schema rejects, runner accepts) is benign here precisely because the runner discards those fields — it cannot smuggle anything through them. If either validator flips a verdict on any vector, one of the two drift suites fails -> CI red, forcing a conscious fixture + cross-reference update. Note: every vector includes allowedHosts/credentials so McpServerSchema sees them explicitly; the runner ignores them either way.",
  "vectors": [
    {
      "desc": "stdio entry is rejected (transport removed)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "github", "transport": "stdio", "command": "npx", "args": ["-y", "pkg"], "env": { "TOKEN": "x" }, "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "valid http entry",
      "core": true,
      "schema": "accept",
      "runner": "accept",
      "value": { "name": "remote", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "name with uppercase (fails id regex)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "GitHub", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "name with leading digit (fails id regex)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "9srv", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "name over 64 chars (fails id regex)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "transport other than http",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "srv", "transport": "websocket", "command": "npx", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "http entry missing url",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "remote", "transport": "http", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "http entry that also sets command (cross-contamination)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "remote", "transport": "http", "url": "https://mcp.example.com", "command": "npx", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "http entry that also sets args (cross-contamination)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "remote", "transport": "http", "url": "https://mcp.example.com", "args": ["x"], "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "http entry that also sets env (cross-contamination)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "remote", "transport": "http", "url": "https://mcp.example.com", "env": { "K": "v" }, "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "http url that is not a valid URL",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": { "name": "remote", "transport": "http", "url": "not a url", "allowedHosts": [], "credentials": [] }
    },
    {
      "desc": "ASYMMETRY (a): malformed allowedHosts (non-string entry) — schema rejects, runner ignores allowedHosts so accepts",
      "core": false,
      "schema": "reject",
      "runner": "accept",
      "value": { "name": "remote", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [1], "credentials": [] }
    },
    {
      "desc": "non-object entry (null)",
      "core": true,
      "schema": "reject",
      "runner": "reject",
      "value": null
    },
    {
      "desc": "non-object entry (array)",
      "core": true,
