      "value": {"name": "remote", "transport": "http", "url": "https://mcp.example.com", "allowedHosts": [], "credentials": [], "headers": {"Authorization": "Bearer ax-cred:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "X-API-Key": "ax-cred:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}}
    },
